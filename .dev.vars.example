GOOGLE_CLIENT_ID=<your google oauth client id>
GOOGLE_CLIENT_SECRET=<your google oauth client secret>
COOKIE_ENCRYPTION_KEY=<random 32-byte hex: openssl rand -hex 32>
HOSTED_DOMAIN=<optional: use this when restrict google account domain>
ALLOWED_EMAILS=<comma-separated Google emails allowed to connect>
MCP_RESOURCE=http://localhost:8788/mcp
